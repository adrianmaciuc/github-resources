      </svg>
      <span class="sr-only">View the repository</span>
    </a>
  </div>

  <header class="page__header">
    <h1 class="page__title">Adi's Snippets</h1>
    <p class="page__subtitle">A messy collection of useful code &amp; notes.</p>
  </header>

  <section class="page__search">
    <label class="search__label" for="search-input">Find something...</label>
    <input
      id="search-input"
      class="search__input"
      type="search"
      placeholder="Type to search (e.g. 'agents', 'playwright')..."
      data-search-input
    />
    <div class="search__results" data-search-results></div>
  </section>

  <section class="snippet-list">
    {% for snippet in collections.snippets %}
      {% include "snippet-card.njk" %}
    {% endfor %}
  </section>
</main>
